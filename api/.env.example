# App
APP_NAME=wongnok
APP_ENV=development
APP_PORT=8080
APP_SHUTDOWN=10s

# Database
POSTGRES_DSN=postgresql://user:pass@host:5432?database=test

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Keycloak
KEYCLOAK_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=pea
KEYCLOAK_CLIENT_ID=wongnok
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
